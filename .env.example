# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings → Environment Variables instead.

# Required: get one at https://console.anthropic.com (separate from your claude.ai login)
ANTHROPIC_API_KEY=

# Provisioned automatically when you add a Postgres store (Neon) to this project in the Vercel dashboard.
# It may land as DATABASE_URL or POSTGRES_URL depending on the integration version — either name works.
DATABASE_URL=

# Provisioned automatically when you add a Blob store to this project in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
